# Copy to .env in the folder you work from (it is git-ignored), or export the variables in your shell.

# ElevenLabs API key, for Scribe transcription (transcribe.py, dossier.py --transcribe, qc.py --transcribe).
ELEVENLABS_API_KEY=

# Optional: transcription language as an ISO 639 code (por, eng, spa...). Empty = Scribe detects it.
SCRIBE_LANGUAGE=

# Optional: only if Resolve is not in its default location.
# macOS default: /Library/Application Support/Blackmagic Design/DaVinci Resolve/Developer/Scripting
RESOLVE_SCRIPT_API=
# macOS default: /Applications/DaVinci Resolve/DaVinci Resolve.app/Contents/Libraries/Fusion/fusionscript.so
RESOLVE_SCRIPT_LIB=
